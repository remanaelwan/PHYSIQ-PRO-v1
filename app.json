{
  "expo": {
    "name": "PhysIQ",
    "slug": "physiq-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./public/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./public/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#04060c"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.physiq.app"
    },
    "android": {
      "package": "com.physiq.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./public/icon.png",
        "backgroundColor": "#04060c"
      },
      "permissions": [
        "CAMERA",
        "INTERNET"
      ]
    },
    "web": {
      "favicon": "./public/favicon.ico"
    }
  }
}
